# Copy this file to .env.local and set values for the current host.
# .env.local is intentionally ignored by Git and loaded after common and architecture files.

# Public URL shown in generated Prompt invocation examples.
COZE_LOOP_PUBLIC_BASE_URL=http://127.0.0.1:8082

# Optional host-specific overrides:
# Use these two values together for a backend-only deployment. The Nginx
# container remains as the API and object-storage gateway, but serves no UI.
# GCS_LOOP_APP_BUILD_TARGET=backend-runtime
# GCS_LOOP_BACKEND_ONLY=true
# COZE_LOOP_NGINX_PORT=8082
# COZE_LOOP_MYSQL_HOST_PORT=13306
# GCS_LOOP_CLICKHOUSE_IMAGE=gcs-loop-clickhouse:26.6.1.1193
