# Shared application settings for every CPU architecture.
# Host-specific overrides belong in ../.env.local.

# app
COZE_LOOP_APP_OPENAPI_PORT=8888
COZE_LOOP_APP_DEBUG_PORT=40000
COZE_LOOP_PUBLIC_BASE_URL=
COZE_LOOP_PROMPT_OPTIMIZER_MODEL_ID=6
COZE_LOOP_PROMPT_OPTIMIZATION_WORKERS=6
COZE_LOOP_PROMPT_OPTIMIZATION_SAMPLE_CONCURRENCY=4

# Build mirrors. Override in .env.local when a host needs a different mirror.
GCS_LOOP_ALPINE_MIRROR=https://mirrors.aliyun.com/alpine
GCS_LOOP_NPM_REGISTRY=https://registry.npmmirror.com

# redis
COZE_LOOP_REDIS_DOMAIN=gcs-loop-redis
COZE_LOOP_REDIS_PORT=6379
COZE_LOOP_REDIS_PASSWORD=coze-loop

# mysql
COZE_LOOP_MYSQL_DOMAIN=gcs-loop-mysql
COZE_LOOP_MYSQL_PORT=3306
COZE_LOOP_MYSQL_HOST_PORT=13306
COZE_LOOP_MYSQL_USER=root
COZE_LOOP_MYSQL_PASSWORD=coze-loop
COZE_LOOP_MYSQL_DATABASE=cozeloop-mysql

# clickhouse
COZE_LOOP_CLICKHOUSE_DOMAIN=gcs-loop-clickhouse
COZE_LOOP_CLICKHOUSE_PORT=9000
COZE_LOOP_CLICKHOUSE_USER=default
COZE_LOOP_CLICKHOUSE_PASSWORD=coze-loop
COZE_LOOP_CLICKHOUSE_DATABASE=cozeloop-clickhouse

# minio
COZE_LOOP_OSS_PROTOCOL=http
COZE_LOOP_OSS_DOMAIN=gcs-loop-minio
COZE_LOOP_OSS_PORT=9000
COZE_LOOP_OSS_REGION=us-east-1
COZE_LOOP_OSS_USER=root
COZE_LOOP_OSS_PASSWORD=coze-loop
COZE_LOOP_OSS_BUCKET=cozeloop-minio

# rocketmq
COZE_LOOP_RMQ_NAMESRV_DOMAIN=gcs-loop-rmq-namesrv
COZE_LOOP_RMQ_NAMESRV_PORT=9876

# nginx
COZE_LOOP_NGINX_PORT=8082
COZE_LOOP_NGINX_DATA_VOLUME_NAME=gcs-loop-nginx-data

# faas
COZE_LOOP_PYTHON_FAAS_DOMAIN=gcs-loop-python-faas
COZE_LOOP_PYTHON_FAAS_PORT=8000
COZE_LOOP_JS_FAAS_DOMAIN=gcs-loop-js-faas
COZE_LOOP_JS_FAAS_PORT=8000
DENO_DIR=/tmp/.deno
DENO_NO_UPDATE_CHECK=1
DENO_V8_FLAGS=--max-old-space-size=2048
FAAS_WORKSPACE=/tmp/faas-workspace
FAAS_PORT=8000
FAAS_TIMEOUT=30000
FAAS_LANGUAGE=python
NUMPY_VERSION=>=1.24.0
PANDAS_VERSION=>=1.5.0
JSONSCHEMA_VERSION=>=4.0.0
SCIPY_VERSION=>=1.10.0
SKLEARN_VERSION=>=1.3.0
