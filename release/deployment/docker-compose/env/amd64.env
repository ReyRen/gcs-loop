# Images verified for linux/amd64.
GCS_LOOP_PLATFORM=linux/amd64
GCS_LOOP_APP_IMAGE=gcs-loop-app:dev
GCS_LOOP_PYTHON_FAAS_IMAGE=gcs-loop-python-faas:1.0.0
GCS_LOOP_JS_FAAS_IMAGE=gcs-loop-js-faas:1.45.5
GCS_LOOP_REDIS_IMAGE=gcs-loop-redis:8.2.0
GCS_LOOP_MYSQL_IMAGE=gcs-loop-mysql:9.4.0
GCS_LOOP_CLICKHOUSE_IMAGE=gcs-loop-clickhouse:26.6.1.1193
GCS_LOOP_MINIO_IMAGE=gcs-loop-minio:RELEASE.2025-06-13T11-33-47Z
GCS_LOOP_ROCKETMQ_IMAGE=gcs-loop-rocketmq:5.3.3
GCS_LOOP_NGINX_IMAGE=gcs-loop-nginx:1.28.0

# Native builder/runtime images installed on the amd64 host.
GCS_LOOP_GO_BUILD_IMAGE=gcs-loop-golang:1.24-alpine
GCS_LOOP_NODE_BUILD_IMAGE=gcs-loop-node:24-alpine
GCS_LOOP_RUNTIME_IMAGE=gcs-loop-base:3.22.0
