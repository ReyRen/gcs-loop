# Copy this file to offline/site.env before installation.
# Verified ARM example: the current 43 deployment is accessed through this URL.
# Keep it only when the target site uses the same address; otherwise replace the IP or domain.
COZE_LOOP_PUBLIC_BASE_URL=http://172.18.127.43:8082

# Optional host port overrides. Uncomment only when the defaults conflict.
# COZE_LOOP_NGINX_PORT=8082
# COZE_LOOP_APP_OPENAPI_PORT=8888
# COZE_LOOP_MYSQL_HOST_PORT=13306

# Optional deployment mode. The packaged app image contains the UI.
# GCS_LOOP_BACKEND_ONLY=false
