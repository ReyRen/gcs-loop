#!/bin/bash
source common/git-hooks/rush-hook-utils.sh

if is_rebase_in_progress || ! head_has_rush_changes; then
  exit
fi

if ! command -v node >/dev/null 2>&1; then
  echo "Warning: skipped 'rush change-x -a' because Node.js is unavailable." >&2
  echo "Run it after installing Node.js to update frontend change metadata." >&2
  exit
fi

node common/scripts/install-run-rush.js change-x -a || exit 1
